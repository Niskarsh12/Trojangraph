# FalkorDB Cloud connection string.
# Free tier has NO TLS -> redis:// ; TLS-enabled paid tiers -> rediss://
# Host/port: Cloud console > Connectivity tab. User/password: Instance Details > Parameter.
# Format: redis://falkordb:<password>@<host>:<port>
FALKORDB_URL=redis://falkordb:your-password@your-endpoint-host:6379

# Optional graph key (defaults to "trojangraph")
FALKORDB_GRAPH=trojangraph

# Optional: without it, /api/draft falls back to a deterministic graph-grounded template.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: Slack incoming webhook for the "Push to Slack / HubSpot" action.
SLACK_WEBHOOK_URL=
